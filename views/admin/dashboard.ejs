<%- include('../partials/header') %>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="gold-text fw-bold">
            <i class="bi bi-speedometer2"></i> داشبورد مدیریت
        </h3>
        <span class="badge bg-warning text-dark p-2">
            <i class="bi bi-shield-lock"></i> پنل ادمین
        </span>
    </div>

    <% if (festival && festival.active) { %>
        <div class="alert alert-warning text-center fw-bold">
            🎉 جشنواره فعال: <%= festival.title %> | سود <%= festival.profitPercent %>%
        </div>
    <% } %>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-warning shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4 text-warning mb-2"></i>
                    <h6 class="text-muted">کل کاربران</h6>
                    <h3 class="gold-text fw-bold"><%= stats.totalUsers %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-success shadow">
                <div class="card-body text-center">
                    <i class="bi bi-arrow-down-circle display-4 text-success mb-2"></i>
                    <h6 class="text-muted">کل واریزها</h6>
                    <h3 class="text-success fw-bold"><%= stats.totalDeposits.toFixed(2) %> USDT</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-danger shadow">
                <div class="card-body text-center">
                    <i class="bi bi-arrow-up-circle display-4 text-danger mb-2"></i>
                    <h6 class="text-muted">کل برداشت‌ها</h6>
                    <h3 class="text-danger fw-bold"><%= stats.totalWithdraws.toFixed(2) %> USDT</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-info shadow">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-4 text-info mb-2"></i>
                    <h6 class="text-muted">کل سود پرداختی</h6>
                    <h3 class="text-info fw-bold"><%= stats.totalProfits.toFixed(2) %> USDT</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card bg-dark border-warning shadow h-100">
                <div class="card-header bg-black text-warning fw-bold">
                    <i class="bi bi-exclamation-triangle"></i> در انتظار تأیید
                </div>
                <div class="card-body text-center">
                    <div class="row">
                        <div class="col-6">
                            <h5 class="text-success">واریزها</h5>
                            <h3 class="text-success"><%= stats.pendingDeposits %></h3>
                            <a href="/admin/transactions?filter=pending" class="btn btn-success btn-sm">مشاهده</a>
                        </div>
                        <div class="col-6">
                            <h5 class="text-danger">برداشت‌ها</h5>
                            <h3 class="text-danger"><%= stats.pendingWithdraws %></h3>
                            <a href="/admin/transactions?filter=pending" class="btn btn-danger btn-sm">مشاهده</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-dark border-info shadow h-100">
                <div class="card-header bg-black text-info fw-bold">
                    <i class="bi bi-people"></i> کاربران جدید
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr class="text-info">
                                    <th>نام</th>
                                    <th>شماره</th>
                                    <th>تاریخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (recentUsers.length > 0) { %>
                                    <% recentUsers.forEach(user => { %>
                                        <tr>
                                            <td><%= user.fullName %></td>
                                            <td><%= user.phone %></td>
                                            <td><%= new Date(user.joinDate).toLocaleDateString('fa-IR') %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="3" class="text-center text-muted">کاربری نیست</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-dark border-0 shadow">
        <div class="card-header bg-black text-warning fw-bold">
            <i class="bi bi-list"></i> آخرین تراکنش‌ها
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-striped mb-0">
                    <thead>
                        <tr class="text-warning">
                            <th>کاربر</th>
                            <th>نوع</th>
                            <th>مبلغ</th>
                            <th>وضعیت</th>
                            <th>تاریخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentTransactions.length > 0) { %>
                            <% recentTransactions.forEach(tx => { %>
                                <tr>
                                    <td><%= tx.userId ? tx.userId.fullName : '---' %></td>
                                    <td><%= tx.type %></td>
                                    <td><%= tx.amount.toFixed(2) %></td>
                                    <td>
                                        <% if (tx.status === 'approved') { %>✅
                                        <% } else if (tx.status === 'pending') { %>⏳
                                        <% } else { %>❌<% } %>
                                    </td>
                                    <td><%= new Date(tx.date).toLocaleString('fa-IR') %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center text-muted py-3">تراکنشی نیست</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
